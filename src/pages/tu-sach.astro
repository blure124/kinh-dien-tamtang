---
import AuthUI from '../components/AuthUI.astro';
import Sidebar from '../components/Sidebar.astro';
---
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tủ Sách Cá Nhân - Kinh Điển Tam Tạng</title>
  </head>
  <body class="bg-gray-50 text-gray-900 flex flex-col md:flex-row min-h-screen">
    
    <Sidebar />

    <main class="flex-1 p-6 md:p-10 relative overflow-y-auto h-screen custom-scrollbar">
      <AuthUI />
      
      <div class="max-w-4xl mx-auto mt-12 md:mt-4 bg-white p-6 md:p-8 rounded-xl shadow-sm border border-gray-100">
        <h1 class="text-3xl font-bold text-gray-800 mb-2">🔖 Tủ Sách Của Tôi</h1>
        <p class="text-gray-500 mb-8 border-b pb-4">Quản lý các đoạn kinh điển và ghi chú bạn đã lưu.</p>
        
        <div id="bookmarks-container" class="space-y-5">
          <p class="text-gray-500 italic">Đang tải dữ liệu...</p>
        </div>
      </div>
    </main>

    <script>
      async function loadAllBookmarks() {
        const container = document.getElementById('bookmarks-container');
        const tokenStr = localStorage.getItem('auth_token');
        
        if (!tokenStr) {
          container.innerHTML = '<div class="p-4 bg-yellow-50 text-yellow-700 rounded-lg">Vui lòng đăng nhập để xem tủ sách cá nhân.</div>';
          return;
        }

        try {
          const res = await fetch('/api/bookmarks', {
            headers: { 'Authorization': `Bearer ${tokenStr}` }
          });
          
          if (!res.ok) throw new Error('Không thể tải dữ liệu');
          const bookmarks = await res.json();
          
          if (bookmarks.length === 0) {
            container.innerHTML = '<p class="text-gray-500">Bạn chưa lưu đoạn kinh hay ghi chú nào.</p>';
            return;
          }

          let html = '';
          bookmarks.forEach(bm => {
            const date = new Date(bm.updated_at).toLocaleDateString('vi-VN');
            const decodedUrl = decodeURIComponent(bm.url_kinh);
            const title = decodedUrl.split('/').pop(); 
            
            html += `
              <div class="p-5 border border-gray-200 rounded-lg hover:shadow-md transition bg-gray-50">
                <a href="${bm.url_kinh}" class="text-lg font-semibold text-blue-700 hover:underline mb-3 block">📄 ${title}</a>
                <blockquote class="border-l-4 border-yellow-400 pl-4 py-2 mb-3 text-gray-700 bg-yellow-50/50 italic">
                  "${bm.selected_text}"
                </blockquote>
                ${bm.note_content ? `<p class="text-sm text-gray-900 font-medium">✏️ Ghi chú: <span class="font-normal text-gray-600">${bm.note_content}</span></p>` : ''}
                <p class="text-xs text-gray-400 mt-4 text-right">Đã lưu ngày: ${date}</p>
              </div>
            `;
          });
          
          container.innerHTML = html;
        } catch (err) {
          container.innerHTML = '<p class="text-red-500">Có lỗi xảy ra khi tải dữ liệu.</p>';
        }
      }

      document.addEventListener('DOMContentLoaded', loadAllBookmarks);
    </script>
  </body>
</html>
