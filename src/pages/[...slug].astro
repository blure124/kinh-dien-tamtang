---
import AuthUI from '../components/AuthUI.astro';
import Sidebar from '../components/Sidebar.astro';
import Highlighter from '../components/Highlighter.astro';
import BookmarkProgress from '../components/BookmarkProgress.astro';

export async function getStaticPaths() {
  const tatCaKinh = await Astro.glob('../content/kinhdien/**/*.md');
  return tatCaKinh.map(kinh => {
    const filePath = kinh.file;
    const pathParts = filePath.split('/content/kinhdien/');
    const urlSlug = pathParts[1].replace('.md', '');
    return {
      params: { slug: urlSlug },
      props: { kinh },
    };
  });
}

const { kinh } = Astro.props;
const { Content } = kinh;
---
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kinh Điển Tam Tạng</title>
  </head>
  <body class="bg-gray-50 text-gray-900 leading-relaxed flex flex-col md:flex-row min-h-screen">
    
    <!-- Sidebar tự động -->
    <Sidebar />

    <!-- Nội dung kinh -->
    <main class="flex-1 p-6 md:p-10 relative overflow-x-hidden">
      <AuthUI />
      
      <!-- Công cụ Bôi đen & Ghi chú -->
      <Highlighter />
      
      <!-- Công cụ Lưu vị trí đọc dở -->
      <BookmarkProgress />
      
      <article class="prose prose-lg max-w-4xl mx-auto mt-12 md:mt-4">
        <Content />
      </article>
    </main>

  </body>
</html>
