---
// src/pages/[...slug].astro
import fs from 'node:fs';
import path from 'node:path';

import AuthUI from '../components/AuthUI.astro';
import Sidebar from '../components/Sidebar.astro';
import Highlighter from '../components/Highlighter.astro';
import BookmarkProgress from '../components/BookmarkProgress.astro';
import ReadingPreferences from '../components/ReadingPreferences.astro';
import PageTools from '../components/PageTools.astro';
import TableOfContents from '../components/TableOfContents.astro';

export async function getStaticPaths() {
  const contentDir = path.join(process.cwd(), 'src/content/kinhdien');

  function getFiles(dir) {
    if (!fs.existsSync(dir)) return [];
    const dirents = fs.readdirSync(dir, { withFileTypes: true });
    const files = dirents.map((dirent) => {
      const res = path.resolve(dir, dirent.name);
      return dirent.isDirectory() ? getFiles(res) : res;
    });
    return Array.prototype.concat(...files);
  }

  const mdFiles = getFiles(contentDir).filter(f => f.endsWith('.md'));

  return mdFiles.map(filePath => {
    const urlSlug = filePath
      .replace(contentDir, '')
      .replace(/\\/g, '/')
      .replace(/^\//, '')
      .replace(/\.md$/, '');

    return {
      params: { slug: urlSlug },
      props: { filePath, urlSlug },
    };
  });
}

const { filePath, urlSlug } = Astro.props;

let rawContent = '';
if (filePath && fs.existsSync(filePath)) {
  rawContent = fs.readFileSync(filePath, 'utf-8');
}

const title = path.basename(filePath, '.md');

const seoDescription = rawContent
  .replace(/[#*`>-]/g, '')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 160) + '...';

const canonicalUrl = `https://tamtangpali.org/${urlSlug}`;

function parseMarkdown(md) {
  if (!md) return '';
  const blocks = md.split(/\n\r?\n/);
  return blocks.map(block => {
    const trimmed = block.trim();
    if (!trimmed) return '';

    if (trimmed.startsWith('#### ')) {
      return `<h4 class="text-lg font-bold text-gray-800 mt-6 mb-3">${formatInline(trimmed.slice(5))}</h4>`;
    }
    if (trimmed.startsWith('### ')) {
      return `<h3 class="text-xl font-bold text-indigo-900 mt-8 mb-4">${formatInline(trimmed.slice(4))}</h3>`;
    }
    if (trimmed.startsWith('## ')) {
      return `<h2 class="text-2xl font-bold text-indigo-900 mt-10 mb-5 border-b pb-2">${formatInline(trimmed.slice(3))}</h2>`;
    }
    if (trimmed.startsWith('# ')) {
      return `<h1 class="text-3xl font-bold text-indigo-950 mt-12 mb-6 border-b-2 pb-3">${formatInline(trimmed.slice(2))}</h1>`;
    }

    if (trimmed.startsWith('>')) {
      const content = trimmed.replace(/^>\s*/gm, '');
      return `<blockquote class="border-l-4 border-indigo-400 pl-4 py-2 italic text-gray-700 bg-indigo-50/50 my-4 rounded-r">${formatInline(content)}</blockquote>`;
    }

    if (trimmed.startsWith('- ') || trimmed.startsWith('* ')) {
      const items = trimmed.split(/\n/).map(line => line.replace(/^[\-\*]\s*/, '').trim());
      return `<ul class="list-disc list-inside space-y-1 my-4">${items.map(item => `<li>${formatInline(item)}</li>`).join('')}</ul>`;
    }

    return `<p class="mb-4 leading-relaxed">${formatInline(trimmed).replace(/\n/g, '<br/>')}</p>`;
  }).join('\n');
}

function formatInline(text) {
  return text
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.*?)\*/g, '<em>$1</em>')
    .replace(/`([^`]+)`/g, '<code class="bg-gray-100 px-1 rounded text-sm font-mono">$1</code>');
}

const htmlContent = parseMarkdown(rawContent);
---
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <title>{title ? `${title} - Kinh Điển Tam Tạng` : 'Kinh Điển Tam Tạng'}</title>
    <meta name="description" content={seoDescription} />

    <!-- Open Graph Dynamic -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} - Kinh Điển Tam Tạng`} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:image" content="https://tamtangpali.org/og-image.jpg" />

    <!-- Twitter Dynamic -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} - Kinh Điển Tam Tạng`} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content="https://tamtangpali.org/og-image.jpg" />

    <script is:inline>
      try {
        const prefs = JSON.parse(localStorage.getItem('reading_prefs'));
        if (prefs && prefs.theme) document.documentElement.classList.add(`theme-${prefs.theme}`);
        if (prefs && prefs.font) document.documentElement.classList.add(`font-reading-${prefs.font}`);
      } catch (e) {}
    </script>
  </head>
  <body class="bg-gray-50 text-gray-900 leading-relaxed flex flex-col md:flex-row min-h-screen transition-colors duration-300">
    
    <!-- Sidebar tự tích hợp Drawer trượt và nút Hamburger cho Mobile -->
    <Sidebar />

    <PageTools />

    <div class="flex-1 flex flex-col xl:flex-row w-full max-w-full overflow-hidden">
      
      <main class="flex-1 p-6 md:p-10 relative transition-colors duration-300 w-full overflow-x-hidden pt-16">
        <AuthUI />
        <Highlighter />
        <BookmarkProgress />
        <ReadingPreferences />
        
        <article class="prose prose-lg max-w-3xl mx-auto transition-all duration-300" data-pagefind-body>
          <div set:html={htmlContent} />
        </article>
      </main>

      <TableOfContents />

    </div>
  </body>
</html>
