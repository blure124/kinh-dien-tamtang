---
// src/components/Sidebar.astro
---
<!-- 1. Nút Hamburger Mở Sidebar (Chỉ hiện trên Mobile < md ở góc trên trái) -->
<button id="btn-toggle-sidebar" class="md:hidden fixed top-3 left-3 z-50 bg-white p-2 rounded-lg shadow-sm border border-gray-200 text-gray-600 hover:text-indigo-600 transition" title="Mở danh mục">
  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
  </svg>
</button>

<!-- 2. Lớp phủ đen làm mờ khi mở menu trên Mobile -->
<div id="sidebar-overlay" class="hidden fixed inset-0 bg-black/50 z-[50] md:hidden"></div>

<!-- 3. Khung chứa Sidebar (Mobile: Trượt ẩn bên trái; Desktop: Ghim cố định cột bên trái) -->
<div id="sidebar-container" class="transition-transform transform -translate-x-full md:translate-x-0 fixed top-0 left-0 md:relative z-[55] h-screen w-80 max-w-[85vw] md:max-w-none bg-white overflow-hidden shadow-xl md:shadow-none flex-shrink-0">
  <aside class="w-full h-full bg-white border-r border-gray-200 overflow-y-auto custom-scrollbar shadow-sm">
    <div class="p-5 pb-20 md:pb-5">
      <div class="flex items-center justify-between mb-6 border-b pb-4">
        <a href="/" class="text-xl font-bold text-gray-800 hover:text-indigo-600 flex items-center gap-2">
          <!-- Icon Sách SVG thay cho emoji -->
          <svg class="w-6 h-6 text-indigo-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          <span>Thư Viện Tam Tạng</span>
        </a>
        <!-- Nút đóng Sidebar trên Mobile -->
        <button id="btn-close-sidebar" class="md:hidden bg-gray-100 p-1.5 rounded-full text-gray-600 hover:bg-gray-200 transition">✕</button>
      </div>
      <!-- Vùng chứa menu trống, sẽ được JS điền vào -->
      <div id="sidebar-content" class="sidebar-tree -ml-5 text-gray-500 italic text-sm px-4">Đang tải danh mục kinh điển...</div>
    </div>
  </aside>
</div>

<style is:global>
  summary::-webkit-details-marker { display: none; }
  summary { list-style: none; }
  .custom-scrollbar::-webkit-scrollbar { width: 6px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 20px; }
</style>

<script>
  // Tải danh mục menu JSON & Sắp xếp số tự nhiên (Natural Sort: an1 -> an2 -> ... -> an10)
  async function loadMenu() {
    try {
      const res = await fetch('/menu.json');
      const tree = await res.json();
      const container = document.getElementById('sidebar-content');

      function buildHTML(node) {
        const keys = Object.keys(node).sort((a, b) => 
          a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' })
        );
        if (keys.length === 0) return '';

        let html = '<ul class="pl-3 border-l border-gray-200 ml-2 space-y-1">';
        for (const key of keys) {
          const item = node[key];
          if (item.isFile) {
            html += `<li class="my-1 py-1">
              <a href="/${item.url}" class="text-sm text-gray-600 hover:text-blue-600 transition block truncate" title="${key}">📄 ${key}</a>
            </li>`;
          } else {
            html += `<li class="my-1">
              <details class="group">
                <summary class="text-sm font-medium text-gray-800 cursor-pointer hover:text-blue-600 list-none flex items-center py-1">
                  <svg class="w-4 h-4 mr-1 text-gray-400 transition-transform group-open:rotate-90 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                  <span class="truncate" title="${key}">📁 ${key}</span>
                </summary>
                ${buildHTML(item.children)}
              </details>
            </li>`;
          }
        }
        html += '</ul>';
        return html;
      }

      if (container) {
        container.innerHTML = buildHTML(tree);
        container.classList.remove('text-gray-500', 'italic', 'px-4');
      }
    } catch (err) {
      console.error('Lỗi tải menu:', err);
      const container = document.getElementById('sidebar-content');
      if (container) container.innerHTML = '<span class="text-red-500">Lỗi tải danh mục. Vui lòng tải lại trang.</span>';
    }
  }

  // Xử lý Bật/Tắt Drawer trượt trên Mobile
  function initMobileDrawer() {
    const btnToggle = document.getElementById('btn-toggle-sidebar');
    const btnClose = document.getElementById('btn-close-sidebar');
    const sidebar = document.getElementById('sidebar-container');
    const overlay = document.getElementById('sidebar-overlay');

    function openSidebar() {
      if (sidebar && overlay) {
        sidebar.classList.remove('-translate-x-full');
        overlay.classList.remove('hidden');
      }
    }

    function closeSidebar() {
      if (sidebar && overlay) {
        sidebar.classList.add('-translate-x-full');
        overlay.classList.add('hidden');
      }
    }

    if (btnToggle) btnToggle.addEventListener('click', openSidebar);
    if (btnClose) btnClose.addEventListener('click', closeSidebar);
    if (overlay) overlay.addEventListener('click', closeSidebar);
  }

  function startSidebar() {
    loadMenu();
    initMobileDrawer();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startSidebar);
  } else {
    startSidebar();
  }
</script>
