---
// src/components/BookmarkProgress.astro
---
<!-- Nút Đánh dấu trang -->
<button id="btn-save-progress" class="fixed bottom-4 left-4 md:bottom-8 md:left-8 z-40 bg-indigo-600 text-white p-3 rounded-full shadow-xl hover:bg-indigo-700 transition-all flex items-center justify-center border-2 border-white" title="Lưu vị trí đọc">
  🔖 <span id="btn-save-text" class="hidden md:inline ml-2 text-sm font-medium">Lưu vị trí</span>
</button>

<!-- Popup hỏi Đọc tiếp có hiển thị trích đoạn -->
<div id="resume-popup" class="hidden fixed top-20 left-1/2 transform -translate-x-1/2 z-50 bg-white p-5 rounded-xl shadow-2xl border border-gray-200 flex flex-col items-center w-[95%] md:w-[400px]">
  <p class="text-sm font-bold text-indigo-700 mb-2">🔖 Tiếp tục đọc?</p>
  <p id="resume-text" class="text-sm text-gray-600 mb-4 text-center italic line-clamp-3 bg-gray-50 p-3 rounded border border-gray-100 w-full">Đang tải vị trí...</p>
  <div class="flex space-x-3 w-full">
    <button id="btn-resume-yes" class="bg-indigo-600 text-white flex-1 py-2 rounded-lg text-sm font-medium hover:bg-indigo-700 shadow-md">Đọc tiếp</button>
    <button id="btn-resume-no" class="bg-gray-100 text-gray-700 flex-1 py-2 rounded-lg text-sm font-medium hover:bg-gray-200">Bỏ qua</button>
  </div>
</div>

<style is:global>
  /* Hiệu ứng Chọn đoạn văn (Fix lỗi giật trang tuyệt đối bằng outline) */
  .bookmark-mode-active p,
  .bookmark-mode-active h2,
  .bookmark-mode-active h3,
  .bookmark-mode-active li {
    transition: background-color 0.2s ease, outline 0.2s ease;
    border-radius: 4px;
  }
  
  .bookmark-mode-active p:hover,
  .bookmark-mode-active h2:hover,
  .bookmark-mode-active h3:hover,
  .bookmark-mode-active li:hover {
    background-color: #fef3c7; /* Màu nền vàng nhạt */
    outline: 2px dashed #f59e0b; /* Viền ảo không chiếm diện tích */
    outline-offset: 4px; /* Đẩy viền ra ngoài một chút cho đẹp */
    cursor: pointer;
  }

  /* Tinh chỉnh cho Dark Mode/Sepia khỏi chói mắt */
  html.theme-dark .bookmark-mode-active p:hover,
  html.theme-dark .bookmark-mode-active h2:hover,
  html.theme-dark .bookmark-mode-active h3:hover,
  html.theme-dark .bookmark-mode-active li:hover {
    background-color: #78350f !important;
    outline: 2px dashed #fbbf24 !important;
    color: #fff !important;
  }

  /* Hiệu ứng chớp sáng khi tìm thấy đoạn văn (Nhảy Bookmark) */
  .highlight-found { animation: highlight-pulse 2s ease-out; }
  @keyframes highlight-pulse { 
    0% { background-color: #fef08a; } 
    100% { background-color: transparent; } 
  }
  html.theme-dark .highlight-found { animation: highlight-pulse-dark 2s ease-out; }
  @keyframes highlight-pulse-dark { 
    0% { background-color: #92400e; } 
    100% { background-color: transparent; } 
  }
</style>

<script>
  const btnSaveProgress = document.getElementById('btn-save-progress');
  const btnSaveText = document.getElementById('btn-save-text');
  const resumePopup = document.getElementById('resume-popup');
  const btnResumeYes = document.getElementById('btn-resume-yes');
  const btnResumeNo = document.getElementById('btn-resume-no');
  const article = document.querySelector('article.prose');

  let savedPIndex = -1;
  let savedSnippet = '';
  let isBookmarkMode = false;

  // 1. Tải tiến trình khi mở trang (Đã sửa lỗi giải mã JSON 2 lớp)
  async function loadProgress() {
    const tokenStr = localStorage.getItem('auth_token');
    if (!tokenStr) return;

    const url_kinh = window.location.pathname;
    try {
      const res = await fetch(`/api/progress?url=${encodeURIComponent(url_kinh)}`, {
        headers: { 'Authorization': `Bearer ${tokenStr}` }
      });
      if (res.ok) {
        const result = await res.json();
        if (result.data) {
          try {
            const parsedOuter = JSON.parse(result.data); 
            if (parsedOuter.text) {
              try {
                // Giải mã lớp JSON thứ 2 chứa pIndex và text
                const parsedInner = JSON.parse(parsedOuter.text);
                if (typeof parsedInner.pIndex === 'number') savedPIndex = parsedInner.pIndex;
                if (parsedInner.text) savedSnippet = parsedInner.text.replace('...', '').trim();
              } catch(err) {
                // Nếu lỗi, nghĩa là dữ liệu cũ không có JSON lớp 2
                savedSnippet = parsedOuter.text.replace('...', '').trim();
              }

              if (savedSnippet) {
                document.getElementById('resume-text').innerText = `"...${savedSnippet}..."`;
                resumePopup.classList.remove('hidden');
              }
            }
          } catch(e) {}
        }
      }
    } catch (err) {}
  }

  // Xử lý cuộn chính xác theo Chỉ số đoạn văn (pIndex)
  if (btnResumeYes) {
    btnResumeYes.addEventListener('click', () => {
      resumePopup.classList.add('hidden');
      if (!article) return;

      const elements = Array.from(article.querySelectorAll('p, h2, h3, h4, li'));
      let targetNode = null;

      // 1. Định vị chuẩn xác tuyệt đối qua chỉ số thứ tự pIndex
      if (savedPIndex >= 0 && savedPIndex < elements.length) {
        targetNode = elements[savedPIndex];
      }

      // 2. Dự phòng: Nếu chỉ số không khớp, tìm theo chuỗi chữ
      if (!targetNode && savedSnippet) {
        for (let el of elements) {
          if (el.textContent.includes(savedSnippet)) {
            targetNode = el;
            break;
          }
        }
      }

      if (targetNode) {
        // Cuộn mượt mà đến đoạn văn và chớp sáng
        targetNode.scrollIntoView({ behavior: 'smooth', block: 'center' });
        targetNode.classList.add('highlight-found');
        setTimeout(() => targetNode.classList.remove('highlight-found'), 2000);
      } else {
        alert('Không tìm thấy vị trí đã lưu.');
      }
    });
  }

  if (btnResumeNo) {
    btnResumeNo.addEventListener('click', () => {
      resumePopup.classList.add('hidden');
    });
  }

  // 2. Chuyển đổi chế độ (Bật / Tắt Bookmark Mode)
  function toggleBookmarkMode() {
    const tokenStr = localStorage.getItem('auth_token');
    if (!tokenStr) {
      alert('Vui lòng đăng nhập để lưu Bookmark.');
      return;
    }

    isBookmarkMode = !isBookmarkMode;

    if (isBookmarkMode) {
      btnSaveProgress.classList.remove('bg-indigo-600', 'hover:bg-indigo-700');
      btnSaveProgress.classList.add('bg-yellow-500', 'hover:bg-yellow-600', 'animate-pulse');
      btnSaveText.innerText = 'Hủy chọn';
      btnSaveText.classList.remove('hidden');
      
      if (article) article.classList.add('bookmark-mode-active');
      
      const msg = document.createElement('div');
      msg.id = 'bookmark-instruction';
      msg.className = 'fixed top-20 left-1/2 transform -translate-x-1/2 bg-yellow-500 text-white px-5 py-2 rounded-full shadow-lg z-50 text-sm font-bold animate-bounce';
      msg.innerText = '👆 Hãy click vào đoạn văn bạn đang đọc dở';
      document.body.appendChild(msg);

    } else {
      resetBookmarkMode();
    }
  }

  function resetBookmarkMode(successText = 'Lưu vị trí') {
    isBookmarkMode = false;
    
    btnSaveProgress.classList.add('bg-indigo-600', 'hover:bg-indigo-700');
    btnSaveProgress.classList.remove('bg-yellow-500', 'hover:bg-yellow-600', 'animate-pulse');
    btnSaveText.innerText = successText;
    
    if (successText !== 'Lưu vị trí') {
       setTimeout(() => {
          btnSaveText.innerText = 'Lưu vị trí';
          btnSaveText.classList.add('hidden');
          btnSaveText.classList.add('md:inline');
       }, 2000);
    } else {
       btnSaveText.classList.add('hidden');
       btnSaveText.classList.add('md:inline');
    }

    if (article) article.classList.remove('bookmark-mode-active');
    
    const msg = document.getElementById('bookmark-instruction');
    if (msg) msg.remove();
  }

  if (btnSaveProgress) {
    btnSaveProgress.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleBookmarkMode();
    });
  }

  // 3. Xử lý khi người dùng CLICK chọn 1 đoạn văn bản (Lưu pIndex)
  if (article) {
    article.addEventListener('click', async (e) => {
      if (!isBookmarkMode) return;
      e.stopPropagation();

      const targetNode = e.target.closest('p, h2, h3, h4, li');
      if (!targetNode) return;

      // Tìm vị trí của đoạn văn trong bài kinh
      const elements = Array.from(article.querySelectorAll('p, h2, h3, h4, li'));
      const pIndex = elements.indexOf(targetNode);

      const tokenStr = localStorage.getItem('auth_token');
      const url_kinh = window.location.pathname;
      
      let snippet = targetNode.textContent.trim().substring(0, 150);
      if (targetNode.textContent.length > 150) snippet += '...';

      const msg = document.getElementById('bookmark-instruction');
      if (msg) msg.innerText = '⏳ Đang lưu...';
      btnSaveProgress.classList.remove('animate-pulse');

      try {
        const res = await fetch('/api/progress', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${tokenStr}` },
          // Lưu cả tọa độ y (dự phòng) và text_snippet chứa pIndex
          body: JSON.stringify({ 
            url_kinh, 
            scroll_y: window.scrollY, 
            text_snippet: JSON.stringify({ pIndex, text: snippet }) 
          })
        });

        if (res.ok) {
          if (msg) msg.remove();
          btnSaveText.classList.remove('hidden');
          resetBookmarkMode('✅ Đã lưu');
        }
      } catch (err) {
        alert('Lỗi kết nối máy chủ.');
        resetBookmarkMode();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', loadProgress);
</script>
