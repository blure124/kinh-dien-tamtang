---
// src/components/TableOfContents.astro
---
<!-- 1. MỤC LỤC MOBILE (Được JS tự động di chuyển lên ĐẦU bài kinh khi chạy) -->
<div id="toc-mobile-wrapper" class="hidden xl:hidden w-full mb-6 bg-white/80 backdrop-blur border border-gray-200 rounded-xl p-3 shadow-sm transition-all">
  <details id="toc-mobile-details" class="group">
    <summary class="flex items-center justify-between font-bold text-gray-800 text-sm cursor-pointer select-none">
      <span class="flex items-center gap-2 text-indigo-700">
        <!-- Icon List SVG -->
        <svg class="w-4 h-4 text-indigo-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path>
        </svg>
        <span>MỤC LỤC BÀI KINH</span>
      </span>
      <!-- Icon mũi tên xoay khi mở -->
      <svg class="w-4 h-4 text-gray-400 group-open:rotate-180 transition-transform shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
      </svg>
    </summary>
    
    <ul id="toc-container-mobile" class="mt-3 pt-3 border-t border-gray-100 space-y-2 text-sm text-gray-600 max-h-60 overflow-y-auto custom-scrollbar">
      <li class="italic text-gray-400">Đang tạo mục lục...</li>
    </ul>
  </details>
</div>

<!-- 2. MỤC LỤC DESKTOP (Ghim cố định bên phải trên PC) -->
<aside class="hidden xl:block w-64 flex-shrink-0 pt-16 pr-4">
  <div class="sticky top-20 bg-white/50 backdrop-blur border border-gray-200 rounded-xl p-4 shadow-sm max-h-[80vh] overflow-y-auto custom-scrollbar">
    <h3 class="font-bold text-gray-800 text-sm border-b border-gray-200 pb-2 mb-3 uppercase tracking-wider flex items-center gap-2">
      <svg class="w-4 h-4 text-indigo-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path>
      </svg>
      <span>Mục lục</span>
    </h3>
    <ul id="toc-container-desktop" class="space-y-2 text-sm text-gray-600">
      <li class="italic text-gray-400">Đang tạo mục lục...</li>
    </ul>
  </div>
</aside>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const article = document.querySelector('article.prose');
    const mobileTocWrapper = document.getElementById('toc-mobile-wrapper');
    const tocMobile = document.getElementById('toc-container-mobile');
    const tocDesktop = document.getElementById('toc-container-desktop');
    const mobileDetails = document.getElementById('toc-mobile-details');

    if (!article) return;

    // Tự động chèn khối Mục Lục Mobile lên TRƯỚC bài kinh
    if (mobileTocWrapper && article.parentNode) {
      article.parentNode.insertBefore(mobileTocWrapper, article);
      mobileTocWrapper.classList.remove('hidden');
    }

    // Quét tìm các thẻ tiêu đề H2, H3 trong bài kinh
    const headings = article.querySelectorAll('h2, h3');
    if (headings.length === 0) {
      // Ẩn khung mục lục mobile nếu bài kinh không có phân đoạn H2/H3
      if (mobileTocWrapper) mobileTocWrapper.style.display = 'none';
      if (tocDesktop) tocDesktop.innerHTML = '<li class="italic text-gray-400">Bài kinh này không có phân đoạn.</li>';
      return;
    }

    let tocHTML = '';
    headings.forEach((heading, index) => {
      if (!heading.id) heading.id = 'section-' + index;
      
      const isH3 = heading.tagName.toLowerCase() === 'h3';
      const paddingClass = isH3 ? 'pl-4 border-l-2 border-gray-200 text-xs' : 'font-medium text-gray-800';
      
      tocHTML += `
        <li class="${paddingClass}">
          <a href="#${heading.id}" class="toc-link hover:text-indigo-600 transition block py-1 line-clamp-2" title="${heading.textContent}">${heading.textContent}</a>
        </li>
      `;
    });

    if (tocMobile) tocMobile.innerHTML = tocHTML;
    if (tocDesktop) tocDesktop.innerHTML = tocHTML;

    // Xử lý cuộn mượt khi bấm nhấp vào liên kết mục lục
    document.querySelectorAll('.toc-link').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = link.getAttribute('href')?.substring(1);
        if (!targetId) return;

        const targetElement = document.getElementById(targetId);
        if (targetElement) {
          if (mobileDetails && mobileDetails.hasAttribute('open')) {
            mobileDetails.removeAttribute('open');
          }

          const y = targetElement.getBoundingClientRect().top + window.scrollY - 80;
          window.scrollTo({ top: y, behavior: 'smooth' });
        }
      });
    });
  });
</script>
