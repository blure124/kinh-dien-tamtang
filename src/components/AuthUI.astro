---
// src/components/AuthUI.astro
---
<div id="auth-container" class="fixed top-3 right-3 md:top-4 md:right-4 z-50">
  <!-- 1. Nút khi CHƯA đăng nhập -->
  <button id="auth-toggle-btn" class="bg-gray-800 text-white text-xs md:text-sm font-semibold px-3.5 py-2 rounded-xl shadow-lg hover:bg-gray-700 transition flex items-center gap-2 active:scale-95">
    <!-- Icon Key -->
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 0121 9z"></path>
    </svg>
    <span>Đăng nhập</span>
  </button>

  <!-- 2. Khung khi ĐÃ đăng nhập (Menu Dropdown Icon chuẩn SVG) -->
  <div id="user-info" class="hidden relative">
    <!-- Nút đại diện tài khoản -->
    <button id="user-menu-btn" class="flex items-center gap-2 bg-white text-gray-800 px-3 py-1.5 md:py-2 rounded-xl shadow-md border border-gray-200 hover:bg-gray-50 transition active:scale-95 text-xs md:text-sm font-semibold">
      <span id="user-avatar" class="w-6 h-6 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-xs uppercase shrink-0">U</span>
      <span id="username-display" class="font-bold text-gray-800 max-w-[80px] sm:max-w-[120px] truncate"></span>
      <!-- Icon Mũi tên xổ xuống -->
      <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
      </svg>
    </button>

    <!-- Menu thả xuống -->
    <div id="user-dropdown" class="hidden absolute right-0 mt-2 w-48 bg-white rounded-xl shadow-2xl border border-gray-100 p-1.5 z-50">
      <div class="px-3 py-2 border-b border-gray-100 mb-1">
        <p class="text-[11px] text-gray-400 font-medium">Tài khoản đăng nhập</p>
        <p id="dropdown-username" class="text-sm font-bold text-indigo-700 truncate"></p>
      </div>

      <!-- Nút Tủ sách (Icon Bookmark SVG) -->
      <a href="/tu-sach" class="flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-700 font-medium transition group">
        <svg class="w-4 h-4 text-gray-500 group-hover:text-indigo-700 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
        </svg>
        <span>Tủ sách cá nhân</span>
      </a>

      <!-- Nút Đăng xuất (Icon Logout SVG) -->
      <button id="logout-btn" class="w-full flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-sm text-red-600 hover:bg-red-50 font-medium transition text-left group">
        <svg class="w-4 h-4 text-red-500 group-hover:text-red-700 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
        </svg>
        <span>Đăng xuất</span>
      </button>
    </div>
  </div>

  <!-- 3. Modal Đăng nhập / Đăng ký -->
  <div id="auth-modal" class="hidden absolute top-11 md:top-12 right-0 bg-white w-72 p-5 rounded-xl shadow-2xl border border-gray-200">
    <div class="flex justify-between mb-4 border-b pb-2">
      <button id="tab-login" class="font-semibold text-blue-600 border-b-2 border-blue-600 pb-1 w-1/2">Đăng nhập</button>
      <button id="tab-register" class="font-semibold text-gray-400 hover:text-blue-500 pb-1 w-1/2">Đăng ký</button>
    </div>

    <form id="auth-form" class="flex flex-col space-y-3">
      <input type="text" id="username" placeholder="Tên tài khoản" class="border p-2 rounded focus:outline-none focus:ring-2 focus:ring-blue-400 bg-gray-50" required>
      <input type="password" id="pin" placeholder="Mã PIN (Đúng 6 số)" pattern="[0-9]{6}" maxlength="6" class="border p-2 rounded focus:outline-none focus:ring-2 focus:ring-blue-400 bg-gray-50" required title="Vui lòng nhập chính xác 6 chữ số">
      
      <p id="auth-message" class="text-sm hidden"></p>
      
      <button type="submit" id="submit-btn" class="bg-blue-600 text-white font-bold py-2 rounded hover:bg-blue-700 transition">
        Đăng nhập ngay
      </button>
    </form>
  </div>
</div>

<script>
  const toggleBtn = document.getElementById('auth-toggle-btn');
  const authModal = document.getElementById('auth-modal');
  const userInfo = document.getElementById('user-info');
  const userMenuBtn = document.getElementById('user-menu-btn');
  const userDropdown = document.getElementById('user-dropdown');
  const usernameDisplay = document.getElementById('username-display');
  const dropdownUsername = document.getElementById('dropdown-username');
  const userAvatar = document.getElementById('user-avatar');
  const logoutBtn = document.getElementById('logout-btn');
  
  const authForm = document.getElementById('auth-form');
  const tabLogin = document.getElementById('tab-login');
  const tabRegister = document.getElementById('tab-register');
  const usernameInput = document.getElementById('username') as HTMLInputElement;
  const pinInput = document.getElementById('pin') as HTMLInputElement;
  const authMessage = document.getElementById('auth-message');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  let isLoginMode = true;

  function checkAuth() {
    const tokenStr = localStorage.getItem('auth_token');
    if (tokenStr) {
      try {
        const tokenData = JSON.parse(atob(tokenStr));
        if (tokenData.exp > Date.now()) {
          toggleBtn.classList.add('hidden');
          authModal.classList.add('hidden');
          userInfo.classList.remove('hidden');
          
          const uname = tokenData.username;
          usernameDisplay.textContent = uname;
          if (dropdownUsername) dropdownUsername.textContent = uname;
          if (userAvatar) userAvatar.textContent = uname.charAt(0).toUpperCase();
          return;
        } else {
          localStorage.removeItem('auth_token');
        }
      } catch(e) {}
    }
    toggleBtn.classList.remove('hidden');
    userInfo.classList.add('hidden');
    userDropdown?.classList.add('hidden');
  }

  checkAuth();

  if (userMenuBtn && userDropdown) {
    userMenuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      userDropdown.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!userInfo.contains(e.target as Node)) {
        userDropdown.classList.add('hidden');
      }
    });
  }

  toggleBtn.addEventListener('click', () => {
    authModal.classList.toggle('hidden');
    authMessage.classList.add('hidden');
  });

  tabLogin.addEventListener('click', (e) => {
    e.preventDefault();
    isLoginMode = true;
    tabLogin.className = "font-semibold text-blue-600 border-b-2 border-blue-600 pb-1 w-1/2";
    tabRegister.className = "font-semibold text-gray-400 hover:text-blue-500 pb-1 w-1/2";
    submitBtn.textContent = "Đăng nhập ngay";
    authMessage.classList.add('hidden');
  });

  tabRegister.addEventListener('click', (e) => {
    e.preventDefault();
    isLoginMode = false;
    tabRegister.className = "font-semibold text-blue-600 border-b-2 border-blue-600 pb-1 w-1/2";
    tabLogin.className = "font-semibold text-gray-400 hover:text-blue-500 pb-1 w-1/2";
    submitBtn.textContent = "Tạo tài khoản";
    authMessage.classList.add('hidden');
  });

  logoutBtn.addEventListener('click', () => {
    localStorage.removeItem('auth_token');
    checkAuth();
  });

  authForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = "Đang xử lý...";
    authMessage.classList.add('hidden');

    const endpoint = isLoginMode ? '/api/login' : '/api/register';
    
    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          username: usernameInput.value.trim(),
          pin: pinInput.value.trim()
        })
      });
      
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Có lỗi xảy ra từ máy chủ');

      if (isLoginMode) {
        localStorage.setItem('auth_token', data.token);
        usernameInput.value = '';
        pinInput.value = '';
        checkAuth();
      } else {
        authMessage.textContent = 'Đăng ký thành công! Đang chuyển...';
        authMessage.className = "text-sm text-green-600 font-medium";
        authMessage.classList.remove('hidden');
        setTimeout(() => tabLogin.click(), 1000);
      }
    } catch (err: any) {
      authMessage.textContent = err.message;
      authMessage.className = "text-sm text-red-500 font-medium";
      authMessage.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = isLoginMode ? "Đăng nhập ngay" : "Tạo tài khoản";
    }
  });
</script>
