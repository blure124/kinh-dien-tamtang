---
// src/components/Highlighter.astro
---
<div id="highlight-tooltip" class="hidden fixed z-50 bg-gray-900 text-white text-sm font-medium px-4 py-2 rounded-full shadow-2xl cursor-pointer hover:bg-blue-600 transition-all border border-gray-700" style="transform: translateX(-50%);">
  ✏️ Lưu chú đoạn này
</div>

<script>
  const tooltip = document.getElementById('highlight-tooltip');
  const article = document.querySelector('article.prose');
  let currentSelection = '';

  if (article) {
    // 1. Hàm tính toán và hiển thị nút thông minh (Responsive)
    const showTooltip = () => {
      const selection = window.getSelection();
      const text = selection.toString().trim();
      
      if (text.length > 0 && article.contains(selection.anchorNode)) {
        currentSelection = text;
        const range = selection.getRangeAt(0);
        const rect = range.getBoundingClientRect();
        
        // Kiểm tra kích thước màn hình (Mobile thường < 768px)
        const isMobile = window.innerWidth <= 768;

        if (isMobile) {
          // MOBILE: Neo nút ở dưới đáy màn hình để né menu của Chrome/Safari
          tooltip.style.top = 'auto';
          tooltip.style.bottom = '40px';
          tooltip.style.left = '50%';
        } else {
          // DESKTOP: Đặt nút nổi lên ngay trên đoạn chữ
          tooltip.style.bottom = 'auto';
          tooltip.style.left = `${rect.left + (rect.width / 2)}px`;
          
          if (rect.top < 60) {
              tooltip.style.top = `${rect.bottom + 15}px`;
          } else {
              tooltip.style.top = `${rect.top - 40}px`;
          }
        }
        
        tooltip.classList.remove('hidden');
      } else {
        tooltip.classList.add('hidden');
      }
    };

    // 2. Lắng nghe đa sự kiện
    document.addEventListener('selectionchange', showTooltip);
    document.addEventListener('mouseup', showTooltip);
    document.addEventListener('touchend', showTooltip);

    // 3. Xử lý khi bấm nút "Lưu chú"
    tooltip.addEventListener('click', async () => {
      const tokenStr = localStorage.getItem('auth_token');
      if (!tokenStr) {
        alert('Bạn cần đăng nhập hoặc tạo tài khoản để sử dụng tính năng Lưu chú!');
        return;
      }

      const note = prompt('Thêm ghi chú cá nhân cho đoạn này (có thể để trống):');
      if (note === null) return; 

      const url_kinh = window.location.pathname;

      try {
        // Đổi lại màu để báo hiệu đang xử lý
        tooltip.textContent = '⏳ Đang lưu...';
        
        const res = await fetch('/api/bookmarks', {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${tokenStr}`
          },
          body: JSON.stringify({ url_kinh, selected_text: currentSelection, note_content: note })
        });

        if (res.ok) {
          applyHighlight(currentSelection, note);
          window.getSelection().removeAllRanges(); 
        } else {
          alert('Có lỗi xảy ra khi lưu vào máy chủ.');
        }
      } catch (err) {
        console.error(err);
      } finally {
        tooltip.textContent = '✏️ Lưu chú đoạn này';
        tooltip.classList.add('hidden');
      }
    });

    // 4. Tải danh sách lưu chú khi mở trang
    async function loadBookmarks() {
      const tokenStr = localStorage.getItem('auth_token');
      if (!tokenStr) return;

      const url_kinh = window.location.pathname;
      try {
        const res = await fetch(`/api/bookmarks?url=${encodeURIComponent(url_kinh)}`, {
          headers: { 'Authorization': `Bearer ${tokenStr}` }
        });
        if (res.ok) {
          const bookmarks = await res.json();
          bookmarks.forEach(bm => applyHighlight(bm.selected_text, bm.note_content));
        }
      } catch (err) {
        console.error(err);
      }
    }

    // 5. Thuật toán tìm và bôi vàng đoạn chữ (Highlight)
    function applyHighlight(text, note) {
      if (!text) return;
      const escapedText = text.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');
      const regex = new RegExp(`(${escapedText})`, 'g');
      
      const elements = article.querySelectorAll('p, li, h2, h3, h4');
      const noteTitle = note ? `Ghi chú: ${note}` : 'Đoạn đã lưu';

      elements.forEach(el => {
         if (el.textContent.includes(text) && !el.innerHTML.includes('<mark>'+text)) {
             el.innerHTML = el.innerHTML.replace(regex, `<mark class="bg-yellow-200 rounded px-1 cursor-help" title="${noteTitle}">$1</mark>`);
         }
      });
    }

    loadBookmarks();
  }
</script>
