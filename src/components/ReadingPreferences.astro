---
// src/components/ReadingPreferences.astro
---
<!-- Nút Bật/Tắt Menu Tùy Chỉnh -->
<div class="fixed bottom-20 right-4 md:bottom-8 md:right-8 z-50 flex flex-col items-end">
  
  <!-- Bảng Tùy Chỉnh (Cố định thiết kế gốc, không bị nhiễm màu từ Theme) -->
  <div id="reading-prefs-panel" class="hidden mb-3 w-64 bg-white rounded-xl shadow-2xl border border-gray-200 p-4 transition-all origin-bottom-right">
     <h3 class="font-bold text-gray-800 text-sm border-b pb-2 mb-3">Tùy chỉnh Giao diện</h3>
     
     <!-- 1. Cỡ chữ -->
     <div class="mb-4">
       <p class="text-xs text-gray-500 mb-1 font-semibold">Cỡ chữ</p>
       <div class="flex items-center justify-between border rounded-lg p-1 bg-gray-50">
         <button id="btn-font-dec" class="px-3 py-1 hover:bg-gray-200 rounded font-bold text-gray-700">-</button>
         <span id="font-size-display" class="text-sm font-medium text-gray-800">100%</span>
         <button id="btn-font-inc" class="px-3 py-1 hover:bg-gray-200 rounded font-bold text-gray-700">+</button>
       </div>
     </div>

     <!-- 2. Phông chữ -->
     <div class="mb-4">
       <p class="text-xs text-gray-500 mb-1 font-semibold">Phông chữ</p>
       <div class="grid grid-cols-2 gap-2">
         <button id="btn-font-sans" class="border py-1.5 rounded text-sm hover:bg-gray-50 bg-gray-100 font-sans font-medium text-gray-800 transition">Sans-serif</button>
         <button id="btn-font-serif" class="border py-1.5 rounded text-sm hover:bg-gray-50 font-serif font-medium text-gray-800 transition">Serif</button>
       </div>
     </div>

     <!-- 3. Màu nền -->
     <div>
       <p class="text-xs text-gray-500 mb-1 font-semibold">Màu nền</p>
       <div class="grid grid-cols-3 gap-2">
         <button id="btn-theme-light" class="border-2 border-transparent py-3 rounded bg-gray-100 hover:border-gray-300 shadow-sm transition" title="Sáng (Mặc định)"></button>
         <button id="btn-theme-sepia" class="border-2 border-transparent py-3 rounded bg-[#fbf0d9] hover:border-[#e8dcc4] shadow-sm transition" title="Sepia (Ngả vàng)"></button>
         <button id="btn-theme-dark" class="border-2 border-transparent py-3 rounded bg-gray-800 hover:border-gray-600 shadow-sm transition" title="Tối (Dark mode)"></button>
       </div>
     </div>
  </div>

  <button id="btn-reading-prefs" class="bg-white text-gray-700 p-3 rounded-full shadow-xl hover:bg-gray-100 transition-all border border-gray-200 flex items-center justify-center w-12 h-12" title="Tùy chỉnh giao diện">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
    </svg>
  </button>
</div>

<!-- Script Inline chống giật màn hình -->
<script is:inline>
  (function() {
    try {
      const prefs = JSON.parse(localStorage.getItem('reading_prefs')) || { theme: 'light', font: 'sans', size: 100 };
      if (prefs.theme) document.documentElement.classList.add(`theme-${prefs.theme}`);
      if (prefs.font) document.documentElement.classList.add(`font-reading-${prefs.font}`);
    } catch (e) {}
  })();
</script>

<script>
  const btnPrefs = document.getElementById('btn-reading-prefs');
  const prefsPanel = document.getElementById('reading-prefs-panel');
  const article = document.querySelector('article.prose');
  
  const btnFontInc = document.getElementById('btn-font-inc');
  const btnFontDec = document.getElementById('btn-font-dec');
  const fontSizeDisplay = document.getElementById('font-size-display');
  
  const btnFontSans = document.getElementById('btn-font-sans');
  const btnFontSerif = document.getElementById('btn-font-serif');
  
  const btnThemeLight = document.getElementById('btn-theme-light');
  const btnThemeSepia = document.getElementById('btn-theme-sepia');
  const btnThemeDark = document.getElementById('btn-theme-dark');

  let currentPrefs = JSON.parse(localStorage.getItem('reading_prefs')) || { theme: 'light', font: 'sans', size: 100 };

  btnPrefs.addEventListener('click', (e) => {
    e.stopPropagation();
    prefsPanel.classList.toggle('hidden');
  });
  
  document.addEventListener('click', (e) => {
    if (!prefsPanel.contains(e.target) && !btnPrefs.contains(e.target)) {
      prefsPanel.classList.add('hidden');
    }
  });

  function applyPrefs() {
    if (article) article.style.fontSize = `${currentPrefs.size}%`;
    fontSizeDisplay.innerText = `${currentPrefs.size}%`;

    document.documentElement.className = ''; 
    document.documentElement.classList.add(`theme-${currentPrefs.theme}`);
    document.documentElement.classList.add(`font-reading-${currentPrefs.font}`);

    btnFontSans.classList.toggle('bg-blue-100', currentPrefs.font === 'sans');
    btnFontSans.classList.toggle('border-blue-400', currentPrefs.font === 'sans');
    btnFontSerif.classList.toggle('bg-blue-100', currentPrefs.font === 'serif');
    btnFontSerif.classList.toggle('border-blue-400', currentPrefs.font === 'serif');

    btnThemeLight.classList.toggle('border-blue-500', currentPrefs.theme === 'light');
    btnThemeSepia.classList.toggle('border-blue-500', currentPrefs.theme === 'sepia');
    btnThemeDark.classList.toggle('border-blue-500', currentPrefs.theme === 'dark');

    localStorage.setItem('reading_prefs', JSON.stringify(currentPrefs));
  }

  btnFontInc.addEventListener('click', () => { if (currentPrefs.size < 200) { currentPrefs.size += 10; applyPrefs(); } });
  btnFontDec.addEventListener('click', () => { if (currentPrefs.size > 80) { currentPrefs.size -= 10; applyPrefs(); } });

  btnFontSans.addEventListener('click', () => { currentPrefs.font = 'sans'; applyPrefs(); });
  btnFontSerif.addEventListener('click', () => { currentPrefs.font = 'serif'; applyPrefs(); });

  btnThemeLight.addEventListener('click', () => { currentPrefs.theme = 'light'; applyPrefs(); });
  btnThemeSepia.addEventListener('click', () => { currentPrefs.theme = 'sepia'; applyPrefs(); });
  btnThemeDark.addEventListener('click', () => { currentPrefs.theme = 'dark'; applyPrefs(); });

  applyPrefs();
</script>

<style is:global>
  /* =========================================
     THEME CSS (CHỈ ÁP DỤNG LÊN NỀN VÀ TRANG ĐỌC)
  ========================================= */

  /* 1. SEPIA THEME */
  html.theme-sepia body { background-color: #fbf0d9 !important; }
  html.theme-sepia aside { background-color: #fbf0d9 !important; border-color: #e8dcc4 !important; }
  html.theme-sepia aside a, html.theme-sepia aside summary, html.theme-sepia aside span { color: #5f4b32 !important; }
  html.theme-sepia aside a:hover, html.theme-sepia aside summary:hover { color: #b45309 !important; }
  
  html.theme-sepia .prose { color: #5f4b32 !important; }
  html.theme-sepia .prose h1, html.theme-sepia .prose h2, html.theme-sepia .prose h3, html.theme-sepia .prose h4 { color: #3f3121 !important; }
  html.theme-sepia .prose strong { color: #3f3121 !important; }
  
  /* 2. DARK THEME */
  html.theme-dark body { background-color: #121212 !important; color: #e0e0e0 !important; }
  html.theme-dark aside { background-color: #1a1a1a !important; border-color: #333 !important; }
  html.theme-dark aside a, html.theme-dark aside summary, html.theme-dark aside span { color: #d4d4d4 !important; }
  html.theme-dark aside a:hover, html.theme-dark aside summary:hover { color: #60a5fa !important; }
  
  html.theme-dark .prose { color: #d4d4d4 !important; }
  html.theme-dark .prose h1, html.theme-dark .prose h2, html.theme-dark .prose h3, html.theme-dark .prose h4 { color: #f5f5f5 !important; }
  html.theme-dark .prose strong { color: #f5f5f5 !important; }
  html.theme-dark .prose a { color: #60a5fa !important; }
  html.theme-dark mark { background-color: #92400e !important; color: #fef3c7 !important; }

  /* 3. FONT FAMILY */
  html.font-reading-serif .prose, html.font-reading-serif .prose h1, html.font-reading-serif .prose h2, html.font-reading-serif .prose h3 {
    font-family: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif !important;
  }
  html.font-reading-sans .prose, html.font-reading-sans .prose h1, html.font-reading-sans .prose h2, html.font-reading-sans .prose h3 {
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif !important;
  }

  /* =========================================
     4. TỐI ƯU KHOẢNG CÁCH ĐOẠN VĂN
  ========================================= */
  .prose p {
    margin-bottom: 1.5em !important;
    line-height: 1.8 !important;
  }
  .prose h1, .prose h2, .prose h3, .prose h4 {
    margin-top: 2em !important;
    margin-bottom: 1em !important;
    line-height: 1.4 !important;
  }
  .prose li {
    margin-bottom: 0.75em !important;
  }
</style>
